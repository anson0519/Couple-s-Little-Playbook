    <!-- Cloud Sync Room Modal -->
    <div id="roomModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-indigo-100 animate-pop space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between">
                <h2 class="text-lg font-black text-slate-800 flex items-center gap-2">
                    <i class="ph-fill ph-cloud-check text-indigo-500 text-2xl"></i> 雲端雙人連線設定
                </h2>
                <button onclick="closeRoomModal()" class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center">
                    <i class="ph-bold ph-x"></i>
                </button>
            </div>

            <div class="bg-indigo-50/80 border border-indigo-100 rounded-2xl p-4 space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-indigo-900">目前雙人房間暗號：</span>
                    <span id="currentRoomDisplay" class="font-mono font-black text-sm bg-white px-3 py-1 rounded-xl text-indigo-600 border border-indigo-200">LOVE-520</span>
                </div>
                <p class="text-[11px] text-slate-600 leading-relaxed">
                    只要你同另一半喺各自嘅手機輸入<strong>相同嘅情侶房間暗號</strong>，所有罪狀、怒氣值同埋「和好/原諒券」就會透過雲端 <strong>100% 即時雙向同步</strong>！
                </p>
                <div class="text-[10px] text-slate-400 pt-1 flex items-center justify-between border-t border-indigo-100">
                    <span>連線狀態：<span id="myUserIdDisplay" class="font-mono font-bold text-indigo-600">檢測中...</span></span>
                    <button onclick="copyRoomCode()" class="text-indigo-600 font-bold hover:underline flex items-center gap-0.5">
                        <i class="ph-bold ph-copy"></i> 複製暗號
                    </button>
                </div>
            </div>

            <div class="space-y-2">
                <label class="block text-xs font-bold text-slate-600">切換 / 加入另一半嘅房間暗號</label>
                <div class="flex gap-2">
                    <input type="text" id="roomCodeInput" placeholder="例如：BB-2026 或 5201314" class="flex-1 border border-slate-200 rounded-2xl px-3.5 py-2.5 text-sm font-bold uppercase focus:outline-none focus:ring-2 focus:ring-indigo-400">
                    <button onclick="joinCustomRoom()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-4 py-2.5 rounded-2xl text-xs shadow-md transition shrink-0">
                        連線同步 🔗
                    </button>
                </div>
            </div>

            <details class="bg-slate-50 border border-slate-200 rounded-2xl p-3 text-xs">
                <summary class="font-bold text-slate-700 cursor-pointer flex items-center justify-between">
                    <span>⚙️ GitHub 部署專用：自訂 Firebase 雲端連線</span>
                    <span class="text-[10px] text-indigo-600">展開設定</span>
                </summary>
                <div class="mt-2.5 space-y-2 text-[11px] text-slate-600 border-t border-slate-200 pt-2">
                    <p>如果你將此網頁放上 GitHub Pages，可以貼上你自己免費申請嘅 Firebase Config JSON，實現跨手機永久即時同步：</p>
                    <textarea id="customFirebaseInput" rows="3" placeholder='{"apiKey": "...", "projectId": "..."}' class="w-full font-mono text-[10px] p-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-1 focus:ring-indigo-400"></textarea>
                    <button onclick="saveCustomFirebaseConfig()" class="w-full py-2 bg-slate-800 hover:bg-slate-900 text-white font-bold rounded-xl transition">
                        儲存並啟動自訂雲端 🚀
                    </button>
                </div>
            </details>

            <div class="pt-2 border-t border-slate-100 space-y-2">
                <button onclick="copyInviteMessage()" class="w-full py-3 rounded-2xl bg-gradient-to-r from-rose-500 to-pink-500 text-white font-bold text-xs shadow-md flex items-center justify-center gap-1.5 hover:opacity-95 transition">
                    <i class="ph-bold ph-share-network text-base"></i> 一鍵複製「邀請網址 + 專屬房號」發俾另一半
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile App Install & Share Guide Modal -->
    <div id="installModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-amber-100 animate-pop space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between">
                <h2 class="text-lg font-black text-slate-800 flex items-center gap-2">
                    <span class="text-2xl">📱</span> 點樣發俾另一半 & 裝落手機？
                </h2>
                <button onclick="closeInstallModal()" class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center">
                    <i class="ph-bold ph-x"></i>
                </button>
            </div>

            <div class="p-3.5 rounded-2xl bg-rose-50 border border-rose-200 space-y-2">
                <div class="text-xs font-black text-rose-700 flex items-center gap-1.5">
                    <span>💌</span> 第一步：發送連結俾另一半（Android / iOS 通用）
                </div>
                <p class="text-[11px] text-slate-600 leading-relaxed">
                    點擊下方按鈕複製邀請訊息，透過 WhatsApp / LINE 發俾佢。只要佢打開連結並入同一個房間暗號（目前：<strong id="installModalRoomCode" class="text-rose-600">LOVE-520</strong>），兩部機就會即時互通！
                </p>
                <button onclick="copyInviteMessage()" class="w-full py-2.5 rounded-xl bg-rose-500 hover:bg-rose-600 text-white font-bold text-xs shadow-sm transition flex items-center justify-center gap-1">
                    <i class="ph-bold ph-copy"></i> 複製邀請連結 & 房號
                </button>
            </div>

            <div class="space-y-2.5 text-xs">
                <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-black text-slate-800 flex items-center gap-1.5">
                        <span>🍎</span> 她用 iPhone (iOS) 點樣變身 App？
                    </div>
                    <p class="text-[11px] text-slate-600 leading-relaxed">
                        1. 用 <strong>Safari</strong> 打開條 Link<br>
                        2. 撳底部中間嘅「分享 <i class="ph-bold ph-export"></i>」按鈕<br>
                        3. 向下碌揀 <strong>「加入主畫面 (Add to Home Screen)」</strong> 即可！
                    </p>
                </div>

                <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 space-y-1">
                    <div class="font-black text-slate-800 flex items-center gap-1.5">
                        <span>🤖</span> 你用 Android 點樣變身 App？
                    </div>
                    <p class="text-[11px] text-slate-600 leading-relaxed">
                        1. 用 <strong>Chrome</strong> 打開條 Link<br>
                        2. 撳右上角「⋮」選單<br>
                        3. 揀 <strong>「加到主畫面」或「安裝應用程式」</strong> 即可！
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Default State
        let coupleProfile = {
            nameA: '豬豬',
            avatarA: '🐻',
            nameB: 'BB',
            avatarB: '🐰'
        };

        let grudges = [
            {
                id: 1,
                offender: 'A',
                category: '🍔 偷食嘢',
                title: '食咗我留喺雪櫃最後一啖甜品，仲要扮無辜！',
                angerLevel: 3,
                compensation: '請飲珍珠奶茶 🧋',
                date: '今日',
                forgiven: false,
                forgivenNote: ''
            }
        ];

        let vouchers = [
            {
                id: 101,
                holder: 'A',
                issuer: 'B',
                title: '🛡️ 免死金牌原諒券',
                desc: '無論犯咩事，憑券即刻無條件原諒一次，不准翻舊帳！',
                date: '預設贈送',
                used: false,
                usedFor: ''
            },
            {
                id: 102,
                holder: 'B',
                issuer: 'A',
                title: '🤝 5分鐘破冰和好券',
                desc: '冷戰期間使用，雙方必須喺 5 分鐘內抱抱和好！',
                date: '預設贈送',
                used: false,
                usedFor: ''
            }
        ];

        const apologyWheelItems = [
            { emoji: '🧋', text: '即刻買杯手搖飲品孝敬對方' },
            { emoji: '💆‍♂️', text: '人肉按摩揼骨 15 分鐘' },
            { emoji: '😘', text: '抱住錫返 10 啖 + 講我愛你' },
            { emoji: '🥩', text: '今個星期請食一頓好西大餐' },
            { emoji: '🧹', text: '包辦今日所有家務/洗碗' },
            { emoji: '🧧', text: '派封 $52 甜蜜氹返利是' },
            { emoji: '🙇‍♂️', text: '錄一段 30 秒超肉麻道歉語音' }
        ];

        let currentFilter = 'all';
        let currentVoucherFilter = 'unused';
        let currentMainView = 'grudges';
        let pendingForgiveGrudgeId = null;
        let wheelRotation = 0;

        let db = null;
        let auth = null;
        let currentUser = null;
        const urlParams = new URLSearchParams(window.location.search);
        let currentRoomCode = (urlParams.get('room') || localStorage.getItem('couple_room_code') || 'LOVE-520').toUpperCase();
        let unsubscribeRoom = null;
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'couple-grudge-app';
        let isUsingCustomCloud = false;

        function loadFromLocalStorage() {
            try {
                const saved = localStorage.getItem(`couple_data_${currentRoomCode}`);
                if (saved) {
                    const parsed = JSON.parse(saved);
                    if (parsed.coupleProfile) coupleProfile = parsed.coupleProfile;
                    if (Array.isArray(parsed.grudges)) grudges = parsed.grudges;
                    if (Array.isArray(parsed.vouchers)) vouchers = parsed.vouchers;
                }
            } catch (e) {
                console.warn('LocalStorage load error:', e);
            }
        }

        function saveToLocalStorage() {
            try {
                localStorage.setItem('couple_room_code', currentRoomCode);
                localStorage.setItem(`couple_data_${currentRoomCode}`, JSON.stringify({
                    coupleProfile,
                    grudges,
                    vouchers,
                    updatedAt: Date.now()
                }));
            } catch (e) {
                console.warn('LocalStorage save error:', e);
            }
        }

        function showToast(icon, text) {
            const toast = document.getElementById('toast');
            document.getElementById('toastIcon').textContent = icon;
            document.getElementById('toastText').textContent = text;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }

        async function initFirebaseSync() {
            loadFromLocalStorage();
            updateUI();

            try {
                let firebaseConfig = null;
                const savedCustomConfig = localStorage.getItem('custom_firebase_config');

                if (savedCustomConfig) {
                    firebaseConfig = JSON.parse(savedCustomConfig);
                    isUsingCustomCloud = true;
                    const inputEl = document.getElementById('customFirebaseInput');
                    if (inputEl) inputEl.value = savedCustomConfig;
                } else if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                    firebaseConfig = JSON.parse(__firebase_config);
                }

                if (!firebaseConfig) {
                    document.getElementById('roomCodeBadge').textContent = `本機儲存 (${currentRoomCode})`;
                    document.getElementById('myUserIdDisplay').textContent = '本機自動保存模式 (未設定雲端)';
                    return;
                }

                const app = initializeApp(firebaseConfig);
                auth = getAuth(app);
                db = getFirestore(app);

                if (!isUsingCustomCloud && typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                onAuthStateChanged(auth, (user) => {
                    currentUser = user;
                    if (user) {
                        document.getElementById('myUserIdDisplay').textContent = `雲端已連線 (${user.uid.slice(0, 6)}...)`;
                        subscribeToCoupleRoom(currentRoomCode);
                    }
                });
            } catch (err) {
                console.error('Cloud init fallback:', err);
                document.getElementById('roomCodeBadge').textContent = `本機模式 (${currentRoomCode})`;
                document.getElementById('myUserIdDisplay').textContent = '本機保存模式';
            }
        }

        function getRoomDocRef(roomCode) {
            if (isUsingCustomCloud) {
                return doc(db, 'coupleRooms', roomCode);
            }
            return doc(db, 'artifacts', appId, 'public', 'data', 'coupleRooms', roomCode);
        }

        function subscribeToCoupleRoom(roomCode) {
            currentRoomCode = roomCode.toUpperCase();
            localStorage.setItem('couple_room_code', currentRoomCode);
            document.getElementById('currentRoomDisplay').textContent = currentRoomCode;
            document.getElementById('roomCodeInput').value = currentRoomCode;
            const installRoomEl = document.getElementById('installModalRoomCode');
            if (installRoomEl) installRoomEl.textContent = currentRoomCode;

            if (!db || !currentUser) {
                loadFromLocalStorage();
                document.getElementById('roomCodeBadge').textContent = `本機: ${currentRoomCode}`;
                updateUI();
                return;
            }

            if (unsubscribeRoom) unsubscribeRoom();
            document.getElementById('roomCodeBadge').textContent = `房間: ${currentRoomCode}`;

            const roomRef = getRoomDocRef(currentRoomCode);

            unsubscribeRoom = onSnapshot(roomRef, (snapshot) => {
                if (snapshot.exists()) {
                    const data = snapshot.data();
                    if (data.coupleProfile) coupleProfile = data.coupleProfile;
                    if (Array.isArray(data.grudges)) grudges = data.grudges;
                    if (Array.isArray(data.vouchers)) vouchers = data.vouchers;
                    saveToLocalStorage();
                    updateUI();
                } else {
                    pushStateToCloud();
                }
            }, (error) => {
                console.error('Sync error:', error);
                showToast('⚠️', '雲端同步暫時中斷，已自動切換為本機保存');
            });
        }

        async function pushStateToCloud() {
            saveToLocalStorage();
            updateUI();
            if (!db || !currentUser) return;
            try {
                const roomRef = getRoomDocRef(currentRoomCode);
                await setDoc(roomRef, {
                    coupleProfile,
                    grudges,
                    vouchers,
                    updatedAt: Date.now(),
                    updatedBy: currentUser.uid
                });
            } catch (e) {
                console.error('Save to cloud error:', e);
            }
        }

        function saveCustomFirebaseConfig() {
            const raw = document.getElementById('customFirebaseInput').value.trim();
            if (!raw) {
                localStorage.removeItem('custom_firebase_config');
                showToast('🧹', '已清除自訂雲端設定，重新載入中...');
                setTimeout(() => location.reload(), 1000);
                return;
            }
            try {
                const parsed = JSON.parse(raw);
                if (!parsed.apiKey || !parsed.projectId) {
                    showToast('⚠️', '請輸入包含 apiKey 同 projectId 嘅完整 JSON！');
                    return;
                }
                localStorage.setItem('custom_firebase_config', JSON.stringify(parsed));
                showToast('🚀', '雲端金鑰已儲存！正在重新連線...');
                setTimeout(() => location.reload(), 1000);
            } catch (err) {
                showToast('❌', 'JSON 格式有誤，請確保係標準 JSON 格式（用雙引號）');
            }
        }

        function updateUI() {
            // Update header & names
            document.getElementById('coupleNamesDisplay').textContent = `${coupleProfile.nameA} & ${coupleProfile.nameB}`;
            document.getElementById('nameA').textContent = coupleProfile.nameA;
            document.getElementById('avatarA').textContent = coupleProfile.avatarA;
            document.getElementById('nameB').textContent = coupleProfile.nameB;
            document.getElementById('avatarB').textContent = coupleProfile.avatarB;

            document.getElementById('formNameA').textContent = coupleProfile.nameA;
            document.getElementById('formAvatarA').textContent = coupleProfile.avatarA;
            document.getElementById('formNameB').textContent = coupleProfile.nameB;
            document.getElementById('formAvatarB').textContent = coupleProfile.avatarB;

            document.getElementById('vFormNameA').textContent = coupleProfile.nameA;
            document.getElementById('vFormAvatarA').textContent = coupleProfile.avatarA;
            document.getElementById('vFormNameB').textContent = coupleProfile.nameB;
            document.getElementById('vFormAvatarB').textContent = coupleProfile.avatarB;

            document.getElementById('filterOptionA').textContent = `只看 ${coupleProfile.nameA}`;
            document.getElementById('filterOptionB').textContent = `只看 ${coupleProfile.nameB}`;
            document.getElementById('vFilterOptionA').textContent = `${coupleProfile.nameA} 的銀包`;
            document.getElementById('vFilterOptionB').textContent = `${coupleProfile.nameB} 的銀包`;

            // Calculate scores
            const unforgivenA = grudges.filter(g => g.offender === 'A' && !g.forgiven);
            const unforgivenB = grudges.filter(g => g.offender === 'B' && !g.forgiven);

            const pointsA = unforgivenA.reduce((sum, g) => sum + g.angerLevel * 10, 0);
            const pointsB = unforgivenB.reduce((sum, g) => sum + g.angerLevel * 10, 0);

            document.getElementById('unforgivenCountA').textContent = unforgivenA.length;
            document.getElementById('unforgivenCountB').textContent = unforgivenB.length;
            document.getElementById('angerPointsA').textContent = `${pointsA} pt`;
            document.getElementById('angerPointsB').textContent = `${pointsB} pt`;

            document.getElementById('angerBarA').style.width = `${Math.min(100, pointsA)}%`;
            document.getElementById('angerBarB').style.width = `${Math.min(100, pointsB)}%`;

            // Vouchers count
            const unusedVouchersA = vouchers.filter(v => v.holder === 'A' && !v.used).length;
            const unusedVouchersB = vouchers.filter(v => v.holder === 'B' && !v.used).length;
            document.getElementById('voucherCountA').textContent = `${unusedVouchersA} 張`;
            document.getElementById('voucherCountB').textContent = `${unusedVouchersB} 張`;

            document.getElementById('totalGrudgeTabCount').textContent = unforgivenA.length + unforgivenB.length;
            document.getElementById('totalVoucherTabCount').textContent = unusedVouchersA + unusedVouchersB;

            const totalPoints = pointsA + pointsB;
            const statusEl = document.getElementById('relationshipStatus');
            if (totalPoints === 0) {
                statusEl.textContent = '恩愛模範情侶 💖';
                statusEl.className = 'text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full';
            } else if (totalPoints <= 60) {
                statusEl.textContent = '小打小鬧情趣中 🤭';
                statusEl.className = 'text-xs font-bold text-amber-600 bg-amber-50 px-2.5 py-1 rounded-full';
            } else {
                statusEl.textContent = '一級警戒！快啲哄返 🚨';
                statusEl.className = 'text-xs font-bold text-rose-600 bg-rose-100 px-2.5 py-1 rounded-full animate-pulse';
            }

            renderGrudges();
            renderVouchers();
        }

        function renderGrudges() {
            const container = document.getElementById('grudgeList');
            const offenderFilter = document.getElementById('offenderFilter').value;

            const filtered = grudges.filter(g => {
                if (currentFilter === 'unforgiven' && g.forgiven) return false;
                if (currentFilter === 'forgiven' && !g.forgiven) return false;
                if (offenderFilter !== 'all' && g.offender !== offenderFilter) return false;
                return true;
            });

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="glass-card rounded-3xl p-10 text-center space-y-2">
                        <div class="text-4xl">🕊️</div>
                        <h3 class="font-bold text-slate-700">呢度乾乾淨淨，無仇無怨！</h3>
                        <p class="text-xs text-slate-400">繼續保持甜蜜，或者點擊上方按鈕記低新一筆小氣帳～</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = filtered.map(g => {
                const isA = g.offender === 'A';
                const offenderName = isA ? coupleProfile.nameA : coupleProfile.nameB;
                const offenderAvatar = isA ? coupleProfile.avatarA : coupleProfile.avatarB;
                const badgeColor = isA ? 'bg-rose-100 text-rose-700 border-rose-200' : 'bg-indigo-100 text-indigo-700 border-indigo-200';
                const fires = '🔥'.repeat(g.angerLevel);

                return `
                    <div class="glass-card rounded-3xl p-4 shadow-sm border transition hover:shadow-md ${g.forgiven ? 'opacity-75 bg-slate-50/70' : 'border-rose-100'}">
                        <div class="flex items-start justify-between gap-2 mb-2.5">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="px-2.5 py-1 rounded-xl text-xs font-black border flex items-center gap-1 ${badgeColor}">
                                    <span>${offenderAvatar}</span>
                                    <span>犯人：${offenderName}</span>
                                </span>
                                <span class="text-xs font-bold bg-slate-100 text-slate-600 px-2.5 py-1 rounded-xl">
                                    ${g.category}
                                </span>
                                <span class="text-xs" title="怒氣值">${fires}</span>
                            </div>
                            <span class="text-[11px] text-slate-400 shrink-0">${g.date}</span>
                        </div>

                        <p class="text-sm font-bold text-slate-800 mb-3 leading-relaxed ${g.forgiven ? 'line-through text-slate-400' : ''}">
                            ${g.title}
                        </p>

                        <div class="bg-amber-50/80 border border-amber-200/70 rounded-2xl p-3 flex items-center justify-between gap-3">
                            <div class="text-xs">
                                <span class="text-amber-700 font-bold block mb-0.5">🎁 賠罪條件：</span>
                                <span class="text-slate-700 font-medium">${g.compensation}</span>
                                ${g.forgiven && g.forgivenNote ? `<span class="block mt-1 text-[11px] text-emerald-600 font-bold">✨ ${g.forgivenNote}</span>` : ''}
                            </div>

                            ${g.forgiven ? `
                                <span class="shrink-0 px-3 py-1.5 rounded-xl bg-emerald-100 text-emerald-700 font-black text-xs flex items-center gap-1">
                                    <i class="ph-fill ph-check-circle"></i> 已原諒💖
                                </span>
                            ` : `
                                <button onclick="forgiveGrudge(${g.id})" class="shrink-0 px-3.5 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white font-bold text-xs shadow-sm shadow-emerald-200 transition active:scale-95 flex items-center gap-1">
                                    <i class="ph-bold ph-heart"></i> 哄好銷案
                                </button>
                            `}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderVouchers() {
            const container = document.getElementById('voucherList');
            const holderFilter = document.getElementById('voucherHolderFilter').value;

            const filtered = vouchers.filter(v => {
                if (currentVoucherFilter === 'unused' && v.used) return false;
                if (currentVoucherFilter === 'used' && !v.used) return false;
                if (holderFilter !== 'all' && v.holder !== holderFilter) return false;
                return true;
            });

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="glass-card rounded-3xl p-10 text-center space-y-2">
                        <div class="text-4xl">🎟️</div>
                        <h3 class="font-bold text-slate-700">銀包入面暫時無呢類神券～</h3>
                        <p class="text-xs text-slate-400">點擊上方「派發和好券」送張免死金牌或者和好特權俾另一半啦！</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = filtered.map(v => {
                const isHolderA = v.holder === 'A';
                const holderName = isHolderA ? coupleProfile.nameA : coupleProfile.nameB;
                const holderAvatar = isHolderA ? coupleProfile.avatarA : coupleProfile.avatarB;
                const issuerName = isHolderA ? coupleProfile.nameB : coupleProfile.nameA;

                return `
                    <div class="glass-card rounded-3xl p-4 shadow-sm border border-violet-200 relative overflow-hidden ${v.used ? 'opacity-70 bg-slate-50' : 'bg-gradient-to-br from-white to-violet-50/40'}">
                        <div class="flex items-center justify-between gap-2 mb-2">
                            <span class="px-2.5 py-1 rounded-xl text-xs font-black bg-violet-100 text-violet-700 border border-violet-200 flex items-center gap-1">
                                <span>${holderAvatar}</span>
                                <span>持有人：${holderName}</span>
                            </span>
                            <span class="text-[11px] text-slate-400">由 ${issuerName} 派發 · ${v.date}</span>
                        </div>

                        <h4 class="text-base font-black text-slate-800 mb-1">${v.title}</h4>
                        <p class="text-xs text-slate-600 mb-3 leading-relaxed">${v.desc}</p>

                        <div class="flex items-center justify-between pt-2.5 border-t border-dashed border-violet-200">
                            ${v.used ? `
                                <span class="text-xs font-bold text-slate-500">🧾 已使用：${v.usedFor || '日常甜蜜兌換'}</span>
                                <span class="px-2.5 py-1 rounded-lg bg-slate-200 text-slate-600 text-xs font-bold">已蓋印失效</span>
                            ` : `
                                <span class="text-[11px] font-bold text-violet-600">✨ 隨時可向對方出示兌換</span>
                                <button onclick="redeemVoucherDirectly(${v.id})" class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-violet-500 to-purple-600 text-white text-xs font-bold shadow-sm hover:opacity-95 transition active:scale-95">
                                    立即使用特權 ⚡
                                </button>
                            `}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function switchMainView(view) {
            currentMainView = view;
            const gSec = document.getElementById('grudgesSection');
            const vSec = document.getElementById('vouchersSection');
            const gBtn = document.getElementById('viewBtn-grudges');
            const vBtn = document.getElementById('viewBtn-vouchers');

            if (view === 'grudges') {
                gSec.classList.remove('hidden');
                vSec.classList.add('hidden');
                gBtn.className = 'flex-1 py-2.5 rounded-xl font-black text-xs sm:text-sm bg-rose-500 text-white shadow-sm transition flex items-center justify-center gap-1.5';
                vBtn.className = 'flex-1 py-2.5 rounded-xl font-black text-xs sm:text-sm text-slate-600 hover:text-violet-600 transition flex items-center justify-center gap-1.5';
            } else {
                gSec.classList.add('hidden');
                vSec.classList.remove('hidden');
                vBtn.className = 'flex-1 py-2.5 rounded-xl font-black text-xs sm:text-sm bg-violet-600 text-white shadow-sm transition flex items-center justify-center gap-1.5';
                gBtn.className = 'flex-1 py-2.5 rounded-xl font-black text-xs sm:text-sm text-slate-600 hover:text-rose-500 transition flex items-center justify-center gap-1.5';
            }
        }

        function setFilter(filter) {
            currentFilter = filter;
            ['all', 'unforgiven', 'forgiven'].forEach(f => {
                const btn = document.getElementById(`tab-${f}`);
                if (f === filter) {
                    btn.className = 'px-3.5 py-2 rounded-xl bg-rose-500 text-white transition';
                } else {
                    btn.className = 'px-3.5 py-2 rounded-xl text-slate-600 hover:text-rose-500 transition';
                }
            });
            renderGrudges();
        }

        function setVoucherFilter(filter) {
            currentVoucherFilter = filter;
            ['unused', 'used'].forEach(f => {
                const btn = document.getElementById(`vtab-${f}`);
                if (f === filter) {
                    btn.className = 'px-3.5 py-2 rounded-xl bg-violet-600 text-white transition';
                } else {
                    btn.className = 'px-3.5 py-2 rounded-xl text-slate-600 hover:text-violet-600 transition';
                }
            });
            renderVouchers();
        }

        function forgiveGrudge(id) {
            const item = grudges.find(g => g.id === id);
            if (!item) return;
            pendingForgiveGrudgeId = id;

            const offenderName = item.offender === 'A' ? coupleProfile.nameA : coupleProfile.nameB;
            document.getElementById('forgiveGrudgeSummary').innerHTML = `
                <div class="font-bold text-rose-700">犯人：${offenderName} (${item.category})</div>
                <div class="text-slate-700">${item.title}</div>
                <div class="text-amber-700 font-bold pt-1">原定賠罪：${item.compensation}</div>
            `;

            const availableVouchers = vouchers.filter(v => v.holder === item.offender && !v.used);
            const vContainer = document.getElementById('availableVouchersForGrudge');

            if (availableVouchers.length > 0) {
                vContainer.innerHTML = `
                    <p class="text-xs font-bold text-violet-600 pt-1">🎟️ 或者動用 ${offenderName} 銀包入面嘅神券直接免死：</p>
                    ${availableVouchers.map(v => `
                        <button onclick="useVoucherToForgive(${v.id})" class="w-full p-3 rounded-2xl border-2 border-violet-200 bg-violet-50 hover:bg-violet-100 text-left flex items-center justify-between transition">
                            <div>
                                <div class="font-black text-xs text-violet-800">${v.title}</div>
                                <div class="text-[11px] text-slate-500">${v.desc}</div>
                            </div>
                            <span class="shrink-0 px-2.5 py-1 rounded-xl bg-violet-600 text-white text-xs font-bold">用券銷案</span>
                        </button>
                    `).join('')}
                `;
            } else {
                vContainer.innerHTML = `
                    <p class="text-[11px] text-slate-400 text-center pt-1">（${offenderName} 目前銀包入面無可用嘅原諒券）</p>
                `;
            }

            document.getElementById('forgiveChoiceModal').classList.remove('hidden');
        }

        function confirmNormalForgive() {
            const item = grudges.find(g => g.id === pendingForgiveGrudgeId);
            if (item) {
                item.forgiven = true;
                item.forgivenNote = '已乖乖履行賠罪條件哄返好！';
                closeForgiveChoiceModal();
                pushStateToCloud();
                showToast('💖', '成功銷案！感情升溫～');
            }
        }

        function useVoucherToForgive(voucherId) {
            const item = grudges.find(g => g.id === pendingForgiveGrudgeId);
            const voucher = vouchers.find(v => v.id === voucherId);
            if (item && voucher) {
                item.forgiven = true;
                item.forgivenNote = `已動用「${voucher.title}」直接免死銷案！`;
                voucher.used = true;
                voucher.usedFor = `抵銷罪狀：${item.category}`;
                closeForgiveChoiceModal();
                pushStateToCloud();
                showToast('🎟️', `成功使用「${voucher.title}」霸氣銷案！`);
            }
        }

        function closeForgiveChoiceModal() {
            document.getElementById('forgiveChoiceModal').classList.add('hidden');
        }

        function redeemVoucherDirectly(voucherId) {
            const voucher = vouchers.find(v => v.id === voucherId);
            if (!voucher) return;
            voucher.used = true;
            voucher.usedFor = '主動出示兌換甜蜜特權';
            pushStateToCloud();
            showToast('✨', `已兌換「${voucher.title}」！快啲叫對方執行啦～`);
        }

        function selectVoucherPreset(title, desc) {
            document.getElementById('voucherTitle').value = title;
            document.getElementById('voucherDesc').value = desc;
        }

        function submitVoucher(e) {
            e.preventDefault();
            const holder = document.querySelector('input[name="voucherReceiver"]:checked').value;
            const issuer = holder === 'A' ? 'B' : 'A';
            const title = document.getElementById('voucherTitle').value.trim();
            const desc = document.getElementById('voucherDesc').value.trim();

            if (!title) return;

            vouchers.unshift({
                id: Date.now(),
                holder,
                issuer,
                title,
                desc,
                date: '剛剛派發',
                used: false,
                usedFor: ''
            });

            closeIssueVoucherModal();
            switchMainView('vouchers');
            pushStateToCloud();
            const holderName = holder === 'A' ? coupleProfile.nameA : coupleProfile.nameB;
            showToast('🎁', `已成功派發神券俾 ${holderName}！`);
        }

        function selectCategory(cat) {
            document.getElementById('selectedCategory').value = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                if (btn.textContent === cat) {
                    btn.className = 'cat-btn p-2.5 rounded-xl border border-rose-300 bg-rose-50 text-rose-600 font-bold transition';
                } else {
                    btn.className = 'cat-btn p-2.5 rounded-xl border border-slate-200 text-slate-600 transition';
                }
            });
        }

        function updateAngerLabel(val) {
            const labels = {
                1: '🔥 輕微扁嘴 (10 pt)',
                2: '🔥🔥 有啲唔開心 (20 pt)',
                3: '🔥🔥🔥 中度嬲豬 (30 pt)',
                4: '🔥🔥🔥🔥 非常火滾 (40 pt)',
                5: '🔥🔥🔥🔥🔥 核爆級大罪 (50 pt)'
            };
            document.getElementById('angerLevelLabel').textContent = labels[val];
        }

        function setCompensation(text) {
            document.getElementById('grudgeCompensation').value = text;
        }

        function submitGrudge(e) {
            e.preventDefault();
            const offender = document.querySelector('input[name="offender"]:checked').value;
            const category = document.getElementById('selectedCategory').value;
            const title = document.getElementById('grudgeTitle').value.trim();
            const angerLevel = parseInt(document.getElementById('angerLevel').value, 10);
            const compensation = document.getElementById('grudgeCompensation').value.trim();

            if (!title) return;

            grudges.unshift({
                id: Date.now(),
                offender,
                category,
                title,
                angerLevel,
                compensation,
                date: '剛剛',
                forgiven: false
            });

            document.getElementById('grudgeTitle').value = '';
            closeAddGrudgeModal();
            switchMainView('grudges');
            pushStateToCloud();
            showToast('💢', '新罪狀已蓋印並同步到雲端！');
        }

        function spinApologyWheel() {
            const wheel = document.getElementById('wheelGraphic');
            const emojiEl = document.getElementById('wheelEmoji');
            const textEl = document.getElementById('wheelResultText');

            wheelRotation += 1080 + Math.floor(Math.random() * 360);
            wheel.style.transform = `rotate(${wheelRotation}deg)`;

            emojiEl.textContent = '🌀';
            textEl.textContent = '命運轉動中...';

            setTimeout(() => {
                const picked = apologyWheelItems[Math.floor(Math.random() * apologyWheelItems.length)];
                emojiEl.textContent = picked.emoji;
                textEl.textContent = picked.text;
            }, 3000);
        }

        function openAddGrudgeModal() { document.getElementById('addGrudgeModal').classList.remove('hidden'); }
        function closeAddGrudgeModal() { document.getElementById('addGrudgeModal').classList.add('hidden'); }
        function openIssueVoucherModal() { document.getElementById('issueVoucherModal').classList.remove('hidden'); }
        function closeIssueVoucherModal() { document.getElementById('issueVoucherModal').classList.add('hidden'); }
        function openWheelModal() { document.getElementById('wheelModal').classList.remove('hidden'); }
        function closeWheelModal() { document.getElementById('wheelModal').classList.add('hidden'); }
        function openSettingsModal() { document.getElementById('settingsModal').classList.remove('hidden'); }
        function closeSettingsModal() { document.getElementById('settingsModal').classList.add('hidden'); }
        function openRoomModal() { document.getElementById('roomModal').classList.remove('hidden'); }
        function closeRoomModal() { document.getElementById('roomModal').classList.add('hidden'); }
        function openInstallModal() { document.getElementById('installModal').classList.remove('hidden'); }
        function closeInstallModal() { document.getElementById('installModal').classList.add('hidden'); }

        function joinCustomRoom() {
            const code = document.getElementById('roomCodeInput').value.trim();
            if (!code) return;
            subscribeToCoupleRoom(code);
            closeRoomModal();
            showToast('🔗', `已切換並連線至房間：${code.toUpperCase()}`);
        }

        function copyRoomCode() {
            const tempInput = document.createElement('input');
            tempInput.value = currentRoomCode;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            showToast('📋', `已複製房間暗號：${currentRoomCode}`);
        }

        function copyInviteMessage() {
            const baseUrl = window.location.origin + window.location.pathname;
            const shareUrl = `${baseUrl}?room=${encodeURIComponent(currentRoomCode)}`;
            const shareText = `💌 親愛嘅 ${coupleProfile.nameB}，我整咗個我哋專屬嘅「情侶小氣簿」！以後有咩記仇、哄返或者派發「免死原諒券」都喺晒呢度～\n👉 點擊呢條專屬連結直接進入我哋嘅房間：\n${shareUrl}\n🔑（房間暗號：${currentRoomCode}）`;
            const tempInput = document.createElement('textarea');
            tempInput.value = shareText;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            showToast('💌', '已複製專屬連結 + 房間暗號！快啲貼上發俾另一半啦～');
        }

        function saveCoupleSettings() {
            const nameA = document.getElementById('inputNameA').value.trim() || '豬豬';
            const avatarA = document.getElementById('inputAvatarA').value;
            const nameB = document.getElementById('inputNameB').value.trim() || 'BB';
            const avatarB = document.getElementById('inputAvatarB').value;

            coupleProfile = { nameA, avatarA, nameB, avatarB };
            closeSettingsModal();
            pushStateToCloud();
            showToast('👩‍❤️‍👨', '情侶設定已更新並同步！');
        }

        // Expose functions to global window for inline onclick handlers
        Object.assign(window, {
            openAddGrudgeModal, closeAddGrudgeModal,
            openIssueVoucherModal, closeIssueVoucherModal,
            openWheelModal, closeWheelModal,
            openSettingsModal, closeSettingsModal,
            openRoomModal, closeRoomModal,
            openInstallModal, closeInstallModal,
            setFilter, setVoucherFilter, switchMainView,
            forgiveGrudge, confirmNormalForgive, useVoucherToForgive, closeForgiveChoiceModal,
            redeemVoucherDirectly, selectVoucherPreset, submitVoucher,
            selectCategory, updateAngerLabel, setCompensation, submitGrudge,
            spinApologyWheel, saveCoupleSettings, joinCustomRoom, copyRoomCode, copyInviteMessage,
            saveCustomFirebaseConfig,
            renderGrudges, renderVouchers
        });

        window.onload = () => {
            initFirebaseSync();
        };
    </script>
</body>
</html>
```
